import {
    Button,
    HorizontalBox,
    Palette,
    ScrollView,
    VerticalBox,
} from "std-widgets.slint";

export struct ShelfRow {
    icon: string,
    preview: string,
    detail: string,
    payload: string,
    file-item: bool,
    shortcut: string,
}

component ShelfCard inherits Rectangle {
    in property <ShelfRow> item-data;
    callback activated();

    height: 54px;
    border-radius: 7px;
    background: touch.pressed ? #252c35 : touch.has-hover ? #20262e : #181d23;
    border-width: 1px;
    border-color: touch.has-hover ? #537f85 : #2a323b;

    HorizontalBox {
        padding: 8px;
        spacing: 8px;
        Text {
            width: 24px;
            text: root.item-data.icon;
            color: #d5eeee;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        VerticalBox {
            spacing: 2px;
            Text {
                text: root.item-data.preview;
                color: #eef1f4;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.item-data.detail;
                color: #8f9aa5;
                font-size: 10px;
                overflow: elide;
            }
        }
        Rectangle {
            width: 38px;
            background: transparent;
            Text {
                text: root.item-data.shortcut;
                color: #cbd2da;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component MainWindow inherits Window {
    title: "meshelf";
    icon: @image-url("../../../assets/meshelf-256.png");
    preferred-width: 460px;
    preferred-height: 400px;
    min-width: 360px;
    min-height: 300px;
    background: #111418;
    forward-focus: keyboard;

    in property <string> device-name: "This device";
    in property <string> default-peer: "Not configured";
    in property <bool> default-peer-online: false;
    in property <string> paste-shortcut: "Ctrl+V";
    in property <string> shelf-shortcut-help: "click or Ctrl+1–5 to copy";
    in property <[ShelfRow]> shelf-items: [];
    in-out property <string> status-text: "Open meshelf, then paste once to send";
    in property <string> reachable-names: "Reachability not checked yet";

    callback paste-and-send();
    callback copy-item(string, bool);
    callback refresh-peers();

    init => { keyboard.focus(); }

    keyboard := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (!event.repeat && event.modifiers.control) {
                if (event.text == "v") {
                    root.paste-and-send();
                    return accept;
                }
                if (event.text == "1" && root.shelf-items.length > 0) {
                    root.copy-item(root.shelf-items[0].payload, root.shelf-items[0].file-item);
                    return accept;
                }
                if (event.text == "2" && root.shelf-items.length > 1) {
                    root.copy-item(root.shelf-items[1].payload, root.shelf-items[1].file-item);
                    return accept;
                }
                if (event.text == "3" && root.shelf-items.length > 2) {
                    root.copy-item(root.shelf-items[2].payload, root.shelf-items[2].file-item);
                    return accept;
                }
                if (event.text == "4" && root.shelf-items.length > 3) {
                    root.copy-item(root.shelf-items[3].payload, root.shelf-items[3].file-item);
                    return accept;
                }
                if (event.text == "5" && root.shelf-items.length > 4) {
                    root.copy-item(root.shelf-items[4].payload, root.shelf-items[4].file-item);
                    return accept;
                }
            }
            return reject;
        }

        VerticalBox {
            width: 100%;
            height: 100%;
            padding: 12px;
            spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "meshelf";
                color: #f3f5f7;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.default-peer-online ? "● mesh ready" : "○ finding mesh";
                color: root.default-peer-online ? #76d69a : #9da5af;
                font-size: 11px;
                vertical-alignment: center;
            }
            Button {
                text: "Paste  " + root.paste-shortcut;
                enabled: root.default-peer-online;
                clicked => { root.paste-and-send(); }
            }
        }

        Rectangle {
            height: 30px;
            border-radius: 5px;
            background: #182025;
            Text {
                x: 9px;
                width: parent.width - 18px;
                height: parent.height;
                text: root.status-text;
                color: #9da9b3;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }
            Tooltip {
                Text {
                    text: root.reachable-names;
                    color: #eef1f4;
                }
            }
        }

        HorizontalBox {
            Text {
                text: "ON THIS DEVICE  ·  " + root.shelf-shortcut-help;
                color: #8f98a4;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Refresh";
                clicked => { root.refresh-peers(); }
            }
        }

        if root.shelf-items.length == 0: Rectangle {
            vertical-stretch: 1;
            min-height: 80px;
            border-radius: 7px;
            background: #161a20;
            border-width: 1px;
            border-color: #282e36;
            VerticalBox {
                padding: 12px;
                alignment: center;
                Text {
                    text: "Shelf empty";
                    color: #d0d5dc;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Incoming items appear here without replacing your clipboard.";
                    color: #858e99;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        if root.shelf-items.length > 0: ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                spacing: 5px;
                for row[index] in root.shelf-items: ShelfCard {
                    item-data: row;
                    activated => { root.copy-item(row.payload, row.file-item); }
                }
            }
        }
        }
    }
}

export component MeshelfTray inherits SystemTrayIcon {
    in property <string> tooltip-text: "meshelf";
    icon: Palette.color-scheme == ColorScheme.dark
        ? @image-url("../assets/meshelf-tray-dark.png")
        : @image-url("../assets/meshelf-tray-light.png");
    tooltip: root.tooltip-text;
    title: "";

    callback open-window();
    callback send-default();
    callback quit();

    Menu {
        MenuItem {
            title: "Open meshelf";
            activated => { root.open-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Open meshelf to paste and send";
            activated => { root.send-default(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
