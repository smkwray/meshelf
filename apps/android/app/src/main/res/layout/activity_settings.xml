<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical">

    <include layout="@layout/view_screen_bar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityHeading="true" android:text="@string/settings_device_section"
                android:textAppearance="@style/TextAppearance.Meshelf.Section" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
                <TextView android:id="@+id/settings_device_name" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Meshelf.Body" />
                <Button android:id="@+id/settings_rename" style="@style/Widget.Meshelf.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_rename" />
            </LinearLayout>
            <TextView android:id="@+id/settings_device_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
                android:text="@string/settings_rename_note"
                android:textAppearance="@style/TextAppearance.Meshelf.Secondary" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:accessibilityHeading="true"
                android:text="@string/settings_save_section"
                android:textAppearance="@style/TextAppearance.Meshelf.Section" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
                <TextView android:id="@+id/settings_save_label" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Meshelf.Body" />
                <Button android:id="@+id/settings_save_change" style="@style/Widget.Meshelf.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_change" />
                <Button android:id="@+id/settings_save_reset" style="@style/Widget.Meshelf.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_reset" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/settings_save_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Meshelf.Secondary" android:visibility="gone" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:accessibilityHeading="true"
                android:text="@string/settings_background_section"
                android:textAppearance="@style/TextAppearance.Meshelf.Section" />
            <Switch android:id="@+id/settings_availability_switch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/availability_switch"
                android:textAppearance="@style/TextAppearance.Meshelf.Body" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/availability_optional"
                android:textAppearance="@style/TextAppearance.Meshelf.Secondary" />
            <TextView android:id="@+id/settings_availability_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Meshelf.Secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
