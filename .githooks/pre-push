#!/usr/bin/env bash
set -euo pipefail

# pre-push — fail closed for smkwray/meshelf.
#
# Allows only an update of refs/heads/main. Rejects tags, --all/--mirror extras,
# editor checkpoint refs, device remotes, and any destination other than
# smkwray/meshelf. Scans every outgoing commit message and every outgoing
# tree/blob against the private denylist.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Bypass (rare, intentional):
#   git push --no-verify

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

DENYLIST=".meshelf-private-denylist"
if [[ ! -s "$DENYLIST" ]]; then
  echo "pre-push: REJECT — $DENYLIST is missing or empty; cannot scan outgoing objects." >&2
  exit 1
fi

normalized="$(
  printf '%s' "$REMOTE_URL" \
    | sed -E \
      -e 's#^git@github\.com:#https://github.com/#' \
      -e 's#^ssh://git@github\.com/#https://github.com/#' \
      -e 's#^https://github\.com/#https://github.com/#' \
      -e 's#\.git$##' \
      -e 's#/$##'
)"
if [[ "$normalized" != "https://github.com/smkwray/meshelf" ]]; then
  echo "pre-push: REJECT — destination must be smkwray/meshelf (remote ${REMOTE_NAME:-?} url ${REMOTE_URL:-empty})." >&2
  echo "pre-push: device remotes, mirrors, and other GitHub repos are forbidden." >&2
  exit 1
fi

ZERO="0000000000000000000000000000000000000000"
outgoing=()
saw_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  saw_ref=1

  if [[ "$local_sha" == "$ZERO" ]]; then
    echo "pre-push: REJECT — ref deletion is not allowed ($remote_ref)." >&2
    exit 1
  fi

  case "$remote_ref" in
    refs/heads/main) ;;
    refs/heads/*)
      echo "pre-push: REJECT — only refs/heads/main may be pushed (got $remote_ref)." >&2
      exit 1
      ;;
    refs/tags/*)
      echo "pre-push: REJECT — tags must not be pushed." >&2
      exit 1
      ;;
    refs/notes/*|refs/original/*|refs/replace/*|refs/stash|refs/wip/*|refs/checkpoints/*|refs/remotes/*)
      echo "pre-push: REJECT — private/working ref must not be pushed ($remote_ref)." >&2
      exit 1
      ;;
    *)
      echo "pre-push: REJECT — forbidden ref $remote_ref." >&2
      exit 1
      ;;
  esac

  if [[ "$remote_sha" == "$ZERO" ]]; then
    outgoing+=("$local_sha")
  else
    outgoing+=("${remote_sha}..${local_sha}")
  fi
done

if [[ "$saw_ref" -eq 0 ]]; then
  echo "pre-push: REJECT — no ref updates were supplied; refusing --all/--mirror/empty push." >&2
  exit 1
fi

python3 - "$DENYLIST" "${outgoing[@]}" <<'PY'
import subprocess
import sys

denylist_path, *ranges = sys.argv[1:]
terms = [
    line.strip().lower().encode()
    for line in open(denylist_path, encoding="utf-8")
    if line.strip() and not line.startswith("#")
]
if not terms:
    raise SystemExit("pre-push: REJECT — denylist has no terms")

rev_list = ["git", "rev-list", "--objects"]
for spec in ranges:
    rev_list.append(spec)
listed = subprocess.run(rev_list, capture_output=True, text=True, check=True).stdout.splitlines()
shas = [line.split(" ", 1)[0] for line in listed if line]
if not shas:
    raise SystemExit("pre-push: REJECT — no outgoing commits")

proc = subprocess.Popen(
    ["git", "cat-file", "--batch"],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
)
hits = []
for sha in shas:
    proc.stdin.write((sha + "\n").encode())
    proc.stdin.flush()
    header = proc.stdout.readline().split()
    if len(header) < 3:
        continue
    size = int(header[2])
    data = proc.stdout.read(size)
    proc.stdout.read(1)
    low = data.lower()
    kind = header[1].decode()
    if any(term in low for term in terms):
        hits.append(f"{sha[:12]} ({kind})")
proc.stdin.close()
proc.wait()
if hits:
    raise SystemExit(
        "pre-push: REJECT — denylisted identifier in outgoing object: "
        + "; ".join(hits[:20])
    )
print(f"pre-push: scanned {len(shas)} outgoing objects")
PY

exit 0
